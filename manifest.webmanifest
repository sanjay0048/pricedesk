{
 "name": "Price Desk",
 "short_name": "Price Desk",
 "description": "Supplier price comparison",
 "start_url": "./",
 "scope": "./",
 "display": "standalone",
 "orientation": "portrait",
 "background_color": "#1F4E79",
 "theme_color": "#1F4E79",
 "share_target": {
  "action": "./share-target",
  "method": "POST",
  "enctype": "multipart/form-data",
  "params": {
   "title": "title",
   "text": "text",
   "files": [
    {
     "name": "file",
     "accept": [
      "application/json",
      ".json",
      "text/plain",
      ".txt",
      "application/octet-stream"
     ]
    }
   ]
  }
 },
 "icons": [
  {
   "src": "icon-192.png",
   "sizes": "192x192",
   "type": "image/png"
  },
  {
   "src": "icon-512.png",
   "sizes": "512x512",
   "type": "image/png"
  },
  {
   "src": "icon-maskable-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  }
 ]
}